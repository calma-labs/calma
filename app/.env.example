# Copy to `app/.env` and fill in. `.env` is gitignored — never commit a real key.
#
# Both must be `https://` / `wss://`. A plaintext `ws://` endpoint puts the API
# key in the clear on the wire, and browsers block it from an HTTPS page anyway.
VITE_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
VITE_SOLANA_WS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
